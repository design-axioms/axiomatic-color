{
  "name": "@design-axioms/color",
  "version": "0.1.0-alpha.0",
  "description": "Constraint-solved, APCA-verified semantic color system with native CSS light-dark() and OKLCH atmosphere.",
  "keywords": [
    "accessibility",
    "apca",
    "axiomatic",
    "color",
    "contrast",
    "css",
    "design-system",
    "light-dark",
    "oklch"
  ],
  "homepage": "https://color.axioms.design",
  "bugs": {
    "url": "https://github.com/design-axioms/axiomatic-color/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/design-axioms/axiomatic-color.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "exports": {
    ".": {
      "design-axioms:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "design-axioms:source": "./src/browser-entry.ts",
      "types": "./dist/browser-entry.d.ts",
      "default": "./dist/browser-entry.js"
    },
    "./runtime": {
      "design-axioms:source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "apca-w3": "^0.1.9",
    "culori": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  },
  "release-plan": {
    "semverIncrementAs": {
      "major": "prerelease",
      "minor": "prerelease",
      "patch": "prerelease"
    },
    "semverIncrementTag": "alpha",
    "publishTag": "alpha"
  }
}
